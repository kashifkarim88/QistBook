generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ItemCategory {
  MOBILE
  BIKE
}

enum ContractStatus {
  ACTIVE
  COMPLETED
  DEFAULTED
}

enum PaymentType {
  ADVANCE
  INSTALLMENT
}

// --------------------------------------
// USER AUTHENTICATION & SECURITY
// --------------------------------------

model User {
  id              String   @id @default(uuid())
  username        String   @unique
  passwordHash    String   
  recoveryKeyHash String   
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// --------------------------------------
// CUSTOMER & GUARANTOR
// --------------------------------------

model Customer {
  id         String   @id @default(uuid())
  fullName   String
  fatherName String
  phone      String   
  address    String
  cnic       String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  guarantors Guarantor[]
  agreements InstallmentAgreement[]

  @@index([phone])
}

model Guarantor {
  id         String   @id @default(uuid())
  customerId String
  fullName   String
  cnic       String
  phone      String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([cnic])
}

// --------------------------------------
// DEDICATED PRODUCT TABLES (BIKE & MOBILE)
// --------------------------------------

model Bike {
  id            String   @id @default(uuid())
  brand         String
  model         String
  color         String
  engineNumber  String   @unique
  chassisNumber String   @unique
  isSold        Boolean  @default(false)
  createdAt     DateTime @default(now())

  agreement InstallmentAgreement?
}

model Mobile {
  id        String   @id @default(uuid())
  brand     String
  model     String
  imei1     String   @unique
  imei2     String?  @unique
  isSold    Boolean  @default(false)
  createdAt DateTime @default(now())

  agreement InstallmentAgreement?
}

// --------------------------------------
// AGREEMENTS & PAYMENTS
// --------------------------------------

model InstallmentAgreement {
  id          String         @id @default(uuid())
  customerId  String         
  category    ItemCategory
  bikeId      String?        @unique
  mobileId    String?        @unique

  totalAmount Float
  status      ContractStatus @default(ACTIVE)
  startDate   DateTime       @default(now()) @db.Date
  createdAt   DateTime       @default(now())

  customer Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  bike     Bike?                @relation(fields: [bikeId], references: [id], onDelete: Restrict)
  mobile   Mobile?              @relation(fields: [mobileId], references: [id], onDelete: Restrict)
  payments InstallmentPayment[]

  @@index([customerId])
  @@index([status])
}

model InstallmentPayment {
  id               String      @id @default(uuid())
  agreementId      String
  paymentType      PaymentType
  amountPaid       Float
  remainingBalance Float
  monthlyInstallment Float     @default(0)
  paymentDate      DateTime    @default(now()) @db.Date
  nextDueDate      DateTime?   @db.Date
  createdAt        DateTime    @default(now())

  agreement InstallmentAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@index([nextDueDate])
  @@index([agreementId, paymentDate(sort: Desc)])
}